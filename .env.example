# ============================================================
# MR. BURGER POS - variables de entorno
# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# El archivo ".env" NUNCA se sube a GitHub.
# ============================================================

# --- Sincronización con la nube (caja del restaurante) ---
# Dirección del espejo en la nube. Déjala vacía para trabajar solo en local.
CLOUD_SYNC_URL=https://mrburger-api.onrender.com
# Secreto compartido entre la caja y la nube. Debe ser EXACTAMENTE el mismo valor que la
# variable CLOUD_SYNC_TOKEN del servicio en Render. Si está vacío, no se sincroniza.
CLOUD_SYNC_TOKEN=
CLOUD_SYNC_ENABLED=true

# --- Opcionales ---
# La clave de sesiones (SECRET_KEY) se genera sola en backend/.secret_key; no hace falta definirla.
# SECRET_KEY=
# La base local por defecto es postgresql://restaurante:...@127.0.0.1:5432/restaurante
# DATABASE_URL=
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Solo para docker-compose ---
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=restaurante_dev
POSTGRES_DB=restaurante
